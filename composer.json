{
    "name": "rowbot/dom",
    "description": "A modern alternative to PHP's built in DOM classes.",
    "authors": [
        {
            "name": "Trevor Rowbotham",
            "homepage": "http://trowbotham.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "rowbot/url": "^4.0",
        "symfony/event-dispatcher": "^6.4|^7.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.5|^11.2",
        "slevomat/coding-standard": "^8.0",
        "squizlabs/php_codesniffer": "^3.7.1"
    },
    "autoload": {
        "psr-4": {
            "Rowbot\\DOM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rowbot\\DOM\\Tests\\": "tests/"
        }
    }
}
